{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "bluetooth=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/mobile-auth.html"
    },
    {
      "source": "/mobile-auth",
      "destination": "/mobile-auth.html"
    },
    {
      "source": "/api/:match*",
      "destination": "https://cybernova-backend.onrender.com/api/:match*"
    }
  ]
}
