<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0B1120">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CyberNova Mobile"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#38BDF8"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Account: student@nkocet.edu"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnScanFingerprint"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Scan Fingerprint"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0284C7"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnScanQr"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Scan Screen QR Code"
        android:textColor="#38BDF8"
        android:backgroundTint="#1E293B"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to authenticate..."
        android:textColor="#E2E8F0"
        android:textSize="13sp"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
