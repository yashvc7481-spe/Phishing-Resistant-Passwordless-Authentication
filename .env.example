# ===================================================
# CyberNova Passwordless Authentication Production Configuration
# ===================================================

# Environment mode ('production' or 'development')
NODE_ENV=production

# Backend listening port (Render automatically sets this to 10000)
PORT=3000

# Strong random secret string for signing JWT session cookies
JWT_SECRET=replace_with_a_long_random_production_secret_key_2026

# Display name of the Relying Party for WebAuthn passkeys
RP_NAME=cyberNova Enterprise Portal

# Relying Party ID (hostname of the frontend, e.g. 'my-app.vercel.app' or 'localhost')
# If omitted, automatically derived from the incoming request host/origin
# RP_ID=cybernova-frontend.vercel.app

# Expected Origin for WebAuthn ceremony validation
# EXPECTED_ORIGIN=https://cybernova-frontend.vercel.app

# Cookie SameSite policy ('lax' for same-origin/rewrites, 'none' for cross-domain)
COOKIE_SAMESITE=lax

# Path to persistent SQLite database (e.g. on Render Disk)
# DATABASE_PATH=/data/cybernova.db
