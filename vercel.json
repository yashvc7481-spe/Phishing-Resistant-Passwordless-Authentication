{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "bluetooth=*, camera=*, microphone=*, usb=*"
        },
        {
          "key": "Feature-Policy",
          "value": "bluetooth *; camera *; microphone *; usb *"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://cybernova-backend.onrender.com/api/:match*"
    }
  ]
}
